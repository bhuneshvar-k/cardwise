# Public hostname Caddy gets an HTTPS certificate for
DOMAIN=cardwise.example.com

# Database password (any long random string)
POSTGRES_PASSWORD=

# 32+ random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
# Authorised redirect URI: https://<DOMAIN>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails that become admins on first sign-in
ADMIN_EMAILS=

# Optional
SENTRY_DSN=
PRIVACY_CONTACT=
